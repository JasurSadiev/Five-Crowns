{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['state', 'lastChanged'])",
        "state": { ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'away' || newData.val() === 'offline')" },
        "lastChanged": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "typing": {
      "$gameId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isBoolean() || newData.val() === null"
        }
      }
    }
  }
}
